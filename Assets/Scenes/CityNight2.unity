--- !u!114 &1470173645
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1470173641}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ee4021ce59f313499a5cab041f02aba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  translationName: Intro
  FallbackText: "\u0422\u042B \u041A\u041E\u0422, \u0418 \u0422\u0415\u0411\u042F
    \u041E\u0421\u0422\u0410\u0412\u0418\u041B\u0418 \u041E\u0414\u041D\u041E\u0413\u041E
    \u0414\u041E\u041C\u0410. \u0422\u0415\u041F\u0415\u0420\u042C \u0423 \u0422\u0415\u0411\u042F
    \u0415\u0421\u0422\u042C \u041D\u0415\u041C\u041D\u041E\u0413\u041E \u0412\u0420\u0415\u041C\u0415\u041D\u0418
    \u0427\u0422\u041E \u0411\u042B \u0420\u0410\u0417\u0413\u0420\u041E\u041C\u0418\u0422\u042C
    \u0412\u0421\u0415 \u041A\u041E\u041C\u041D\u0410\u0422\u042B, \u0423\u0421\u0422\u0420\u041E\u0418\u0422\u042C
    \u0411\u0415\u0421\u041F\u041E\u0420\u042F\u0414\u041E\u041A, \u0423\u041D\u0418\u0427\u0422\u041E\u0416\u0418\u0422\u042C
    \u041C\u0410\u041A\u0421\u0418\u041C\u0423\u041C \u0425\u0420\u0423\u041F\u041A\u0418\u0425
    \u0412\u0415\u0429\u0415\u0419 \u0421\u0422\u0410\u041B\u041A\u0418\u0412\u0410\u042F
    \u0418\u0425 \u041D\u0410 \u041F\u041E\u041B, \u0410 \u0422\u0410\u041A\u0416\u0415
    \u0411\u0415\u0421\u0426\u0415\u041D\u041D\u042B\u0425 \u041F\u0420\u0415\u0414\u041C\u0415\u0422\u041E\u0412
    \u0418 \u0414\u041E\u0420\u041E\u0413\u0423\u042E \u042D\u041B\u0415\u041A\u0422\u0420\u041E\u041D\u0418\u041A\u0423,
    \u0427\u0422\u041E\u0411\u042B \u041F\u0420\u0418\u041D\u0415\u0421\u0422\u0418
    \u041C\u0410\u041A\u0421\u0418\u041C\u0410\u041B\u042C\u041D\u042B\u0419 \u0423\u0429\u0415\u0420\u0411
    \u0421\u0412\u041E\u0415\u041C\u0423 \u041B\u042E\u0411\u0418\u041C\u041E\u041C\u0423
    \u0412\u041B\u0410\u0414\u0415\u041B\u042C\u0426\u0423. "
